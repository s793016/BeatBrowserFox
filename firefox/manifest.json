{
  "manifest_version": 2,
  "name": "BeatBrowser (Firefox)",
  "version": "1.4.1",
  "description": "Let any MCP-capable AI agent control your own Firefox, with all your signed-in sessions.",
  "browser_specific_settings": {
    "gecko": {
      "id": "beatbrowser-firefox@local",
      "strict_min_version": "128.0"
    }
  },
  "background": {
    "page": "background.html",
    "persistent": true
  },
  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "BeatBrowser",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "sidebar_action": {
    "default_panel": "panel.html",
    "default_title": "BeatBrowser",
    "default_icon": "icons/icon48.png",
    "open_at_install": false
  },
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "alarms",
    "downloads",
    "notifications",
    "<all_urls>"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
